# Copy to `.env` for local development.
# Option A (easiest — no Postgres password needed):
DATABASE_URL=sqlite:///instance/iqbalai_local.db
SKIP_EXTRA_STARTUP=true
ENV=local

# Hybrid RAG: indexed PostgreSQL sparse retrieval + dense vectors + reranking.
RAG_CROSS_ENCODER_ENABLED=true
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_CROSS_ENCODER_PRELOAD=true
RAG_HYBRID_CANDIDATE_MULTIPLIER=4
RAG_HYBRID_MIN_CANDIDATES=32
RAG_NEIGHBOR_RADIUS=8
RAG_RERANK_MAX_LENGTH=192
RAG_RERANK_WINDOW_CHARS=650
RAG_RERANK_MAX_WINDOWS=1
RAG_RERANK_BATCH_SIZE=16
RAG_ASPECT_LEADER_QUOTA=3
RAG_PARENT_CONTEXT_RADIUS=12
RAG_MAX_CONTEXT_CHUNKS=24

# Option B (Postgres — only if you know your local password):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mydatabase
# SKIP_EXTRA_STARTUP=true
